{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MessageBoard": "Data Source=data/agent-board.db"
  },
  "Keycloak": {
    "Realm": "agents",
    "AuthServerUrl": "https://staging.dauth.me/",
    "SslRequired": "external",
    "Resource": "agent-message-board",
    "VerifyTokenAudience": true
  },
  "MessageBoard": {
    "PublicUrl": "http://localhost:5080",
    "Scopes": [ "openid", "profile", "email", "offline_access" ]
  }
}
